# ============================================================
# 敏感資料：絕對不可進版控
# ============================================================
# 新北市政府提供的真實文件（非營利幼兒園會計師查核財報、公校決算書）
# 這些是實際機構的財務資料，來源為你 AWS 帳號的 S3 私有 bucket。
data/raw/
data/extracted/

# 含真實機構財務數字的資料庫
*.db
*.db-wal
*.db-shm
data/_backup/

# AWS 帳號盤點結果（含帳號 ID、ARN、bucket 名稱）
data/aws_inventory.json

# Agent 產出的風險報告（含真實機構名稱與判定）
reports/

# 認證與環境變數
.env
.env.*
!.env.example
*.pem
*.key
credentials
credentials.bak*

# ============================================================
# 建置產物與快取
# ============================================================
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# ============================================================
# 執行過程檔案
# ============================================================
*.log
smoke.txt
pip.log

# ============================================================
# 編輯器與作業系統
# ============================================================
.vscode/
.idea/
*.swp
*~
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
